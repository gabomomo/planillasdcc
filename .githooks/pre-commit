#!/bin/sh
# Impide subir datos de planilla a un repositorio PUBLICO.
# Instalar una sola vez:   git config core.hooksPath .githooks

datos=$(git diff --cached --name-only --diff-filter=A | grep -iE '\.(xlsx|xlsm|xls|csv)$')
if [ -n "$datos" ]; then
    echo ""
    echo "  COMMIT DETENIDO: esto lleva datos de planilla."
    echo ""
    echo "$datos" | sed 's/^/     /'
    echo ""
    echo "  Este repositorio es PUBLICO. Esos archivos traen nombres,"
    echo "  cedulas, telefonos y salarios de personas reales."
    echo ""
    echo "  Quitelos con:   git restore --staged <archivo>"
    echo ""
    exit 1
fi

# el motor no se puede separar entre las dos versiones
if git diff --cached --name-only | grep -qE '^(programa|docs)/planilla\.py$'; then
    if ! diff -q programa/planilla.py docs/planilla.py >/dev/null 2>&1; then
        echo ""
        echo "  COMMIT DETENIDO: las dos copias del motor no coinciden."
        echo ""
        echo "  programa/planilla.py  (version local)"
        echo "  docs/planilla.py      (version del navegador, la que sirve Pages)"
        echo ""
        echo "  Copie una sobre la otra:   cp programa/planilla.py docs/planilla.py"
        echo ""
        exit 1
    fi
fi
exit 0
